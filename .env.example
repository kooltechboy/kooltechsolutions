# ─── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ─── Google Gemini AI ──────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your_google_ai_key_here

# ─── Resend Email ─────────────────────────────────────────────────────────────
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# ─── Admin Configuration ──────────────────────────────────────────────────────
# Comma-separated list of email addresses that have admin panel access.
# These users must also have a valid Supabase account.
# Example: ADMIN_EMAILS=admin@yourcompany.com,manager@yourcompany.com
ADMIN_EMAILS=your_admin_email@example.com

# ─── Notification Email ───────────────────────────────────────────────────────
# Where admin alerts (new leads, tickets, bookings) are sent
ADMIN_NOTIFICATION_EMAIL=your_admin_email@example.com

# ─── Discord Alerts (Optional) ────────────────────────────────────────────────
# Paste a Discord webhook URL to receive instant Slack-style alerts
DISCORD_LEADS_WEBHOOK=
DISCORD_TICKETS_WEBHOOK=

# ─── LiveKit ──────────────────────────────────────────────────────────────────
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=

# ─── Wazuh SIEM (Optional) ───────────────────────────────────────────────────
# Set to 0 ONLY if your Wazuh instance uses a self-signed TLS certificate
# WAZUH_TLS_VERIFY=0
# Cryptographically random secret for Wazuh webhook authentication (generate with: openssl rand -hex 32)
WAZUH_WEBHOOK_SECRET=

# ─── ITFlow PSA (Optional) ───────────────────────────────────────────────────
# Dedicated secret for automated ITFlow sync (generate with: openssl rand -hex 32)
ITFLOW_SYNC_SECRET=

# ─── Upstash Redis (Optional — enables distributed rate limiting) ─────────────
# Without this, rate limiting falls back to in-memory (ineffective in serverless)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
